# Cấu hình biến môi trường kết nối Google Sheets (dành cho tính năng Nộp bài)
# Xem hướng dẫn chi tiết tại file HUONG_DAN_NOP_BAI.md

# 1. Email tài khoản dịch vụ (client_email trong file JSON khoá Google)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 2. Khoá riêng (private_key trong file JSON, bao gồm cả -----BEGIN PRIVATE KEY----- và xuống dòng \n)
GOOGLE_PRIVATE_KEY=

# 3. Mã ID bảng tính Google Sheet (chuỗi ký tự ở giữa /d/ và /edit trên thanh địa chỉ)
GOOGLE_SHEET_ID=

# 4. (Tuỳ chọn) Tên miền riêng nếu có, phân tách bằng dấu phẩy
MIEN_CHO_PHEP_THEM=
